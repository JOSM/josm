<ivysettings>
  <settings defaultResolver="josm-nexus"/>
  <resolvers>
    <ibiblio name="josm-nexus" m2compatible="true" root="https://josm.openstreetmap.de/repository/public/" />
  </resolvers>

  <!-- Remove specific statements in build.xml when we drop older Java as a build platform -->

  <property name="versions.junit5-system-exit" value="2.0.2" />
  
  <property name="versions.checkstyle" value="12.3.1" unlessset="isJava21" />
  <property name="versions.checkstyle" value="13.2.0" ifset="isJava21"/>

  <property name="versions.errorprone" value="2.42.0" unlessset="isJava21" />
  <property name="versions.errorprone" value="2.47.0" ifset="isJava21"/>

  <property name="versions.jmockit" value="1.50" />

  <property name="versions.equalsverifier" value="4.3.1" />
</ivysettings>
